# GlamQuote AI — the one environment file. Copy to .env (git-ignored) and fill in the values.

# ── App (public) ─────────────────────────────────────────────────────────────
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and is PUBLIC.
# From the Supabase dashboard: Project Settings → API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ── Server secrets (never in the app) ────────────────────────────────────────
# These have NO EXPO_PUBLIC_ prefix, so Expo leaves them out of the app. Never add that prefix.
# They are read by the local smoke test and uploaded to Supabase Edge Functions with:
#   npx supabase secrets set --env-file .env --project-ref <your-project-ref>

# YouCam API key (Bearer token) from https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=your-youcam-api-key

# Optional: chargeable Nail Transfer requests allowed per guest per 24 hours (default 10).
# NAIL_TRANSFER_DAILY_LIMIT=10

# Cloudinary — private storage for looks the user explicitly saves (Save to Lookbook).
# From the Cloudinary console: Settings → API Keys.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Not used yet (later phases):
# GEMINI_API_KEY=your-gemini-api-key

# Never put the Supabase secret / service-role key or database password in this file;
# Edge Functions receive the Supabase keys automatically.
