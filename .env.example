# GlamQuote AI — the one environment file. Copy to .env (git-ignored) and fill in the values.

# ── App (public) ─────────────────────────────────────────────────────────────
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and is PUBLIC.
# From the Supabase dashboard: Project Settings → API Keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ── Server secrets (never in the app) ────────────────────────────────────────
# These have NO EXPO_PUBLIC_ prefix, so Expo leaves them out of the app. Never add that prefix.
# They are read by the local smoke test, and set as Supabase Edge Function secrets with:
#   npx supabase secrets set YOUCAM_API_KEY=… CLOUDINARY_CLOUD_NAME=… … --project-ref <ref>
# (only the provider keys below — never upload SUPABASE_ACCESS_TOKEN).

# YouCam API key (Bearer token) from https://yce.makeupar.com/api-console/en/api-keys/
YOUCAM_API_KEY=your-youcam-api-key

# Optional: chargeable previews (all features) allowed per guest per 24 hours (default 10).
# GENERATION_DAILY_LIMIT=10

# Cloudinary — private storage for looks the user explicitly saves (Save to Lookbook).
# From the Cloudinary console: Settings → API Keys. The cloud name is the "Product Environment".
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Deploy only (local machine) ──────────────────────────────────────────────
# Personal access token for the Supabase CLI (supabase.com/dashboard/account/tokens).
# Needed only while deploying; delete it from .env afterwards. Never set it as a function secret.
# SUPABASE_ACCESS_TOKEN=sbp_your-token

# Not used yet (later phases):
# GEMINI_API_KEY=your-gemini-api-key

# Never put the Supabase secret / service-role key or database password in this file;
# Edge Functions receive the Supabase keys automatically.
